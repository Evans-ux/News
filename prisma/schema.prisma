generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String            @unique
  name            String?
  comments        comments[]
  subscriber      subscribers?
  user_roles        user_roles[]
  authors authors?
}

model authors {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  user_Id            String       @unique @db.Uuid
  bio                String?
  social_media_links Json?
  approved           Boolean      @default(false)
  blog_posts         blog_posts[]
  comments           comments[]
  urlToImage         String?
  user  User? @relation(fields: [user_Id], references: [id], onDelete: Cascade)
}

model blog_posts {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  content         String
  author_id       String?           @db.Uuid
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @db.Timestamp(6)
  description     String
  urlToImage      String?
  authors         authors?          @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  comments        comments[]
  post_categories post_categories[]
  post_tags       post_tags[]
}
 

model categories {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @unique
  description     String?
  post_categories post_categories[]

}

model comments {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String?     @db.Uuid
  author_id  String?     @db.Uuid
  userId     String      @db.Uuid
  content    String
  created_at DateTime?   @default(now()) @db.Timestamp(6)
  authors    authors?    @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  blog_posts blog_posts? @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User       User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model post_categories {
  post_id     String     @db.Uuid
  category_id String     @db.Uuid
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blog_posts  blog_posts @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, category_id])
}

model post_tags {
  post_id    String     @db.Uuid
  tag_id     String     @db.Uuid
  blog_posts blog_posts @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags       tags       @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, tag_id])
}

model subscribers {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  subscribed_at DateTime? @default(now()) @db.Timestamp(6)
  is_active     Boolean?  @default(true)
  user_id       String?   @unique @db.Uuid
  User          User?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model tags {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String      @unique
  post_tags post_tags[]
 
}

model roles {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @unique
  user_roles user_roles[]
 
}

model user_roles {
  user_id String @db.Uuid
  role_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role    roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
}
